rhal.module @laya attributes {
  version = "0.1.0", model_name = "laya_buckyball-poly",
  runner_library = "file:liblaya-buckyball-poly-runner.so", image_base = "@MODEL_IMAGE@"
} {
  rhal.constant @params {id = 1 : i32, storage = "external", type = tensor<?xf32>, uri = "ddr/pack-f32.data"}
  rhal.constant @weights {id = 2 : i32, storage = "external", type = tensor<?xi8>, uri = "ddr/pack-i8.data"}
  rhal.codeobj @model_kernels {id = 1 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:liblaya-buckyball-poly-model.so", entry_symbol = "laya_run"}
}
