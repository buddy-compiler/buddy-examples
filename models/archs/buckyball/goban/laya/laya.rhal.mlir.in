rhal.module @laya attributes {
  version = "0.1.0", model_name = "laya_buckyball-goban",
  runner_library = "file:liblaya-buckyball-goban-runner.so",
  image_base = "@MODEL_IMAGE@"
} {
  rhal.constant @params {id = 1 : i32, storage = "external", type = tensor<?xf32>, uri = "ddr/arg0.data"}
  rhal.constant @bias {id = 2 : i32, storage = "external", type = tensor<?xi32>, uri = "ddr/arg1.data"}
  rhal.constant @weights {id = 3 : i32, storage = "external", type = tensor<?xi8>, uri = "ddr/arg2.data"}
  rhal.codeobj @model_kernels {id = 1 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:liblaya-buckyball-goban-model.so", entry_symbol = "laya_run"}
}
