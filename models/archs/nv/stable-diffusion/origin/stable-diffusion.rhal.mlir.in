rhal.module @stable_diffusion attributes {
  version = "0.1.0",
  model_name = "stable_diffusion_nv_origin",
  runner_library = "file:libstable-diffusion-nv-origin-runner.so",
  vocab_uri = "file:@MODEL_DIR@/stable-diffusion/vocab.txt"
} {
  rhal.constant @text_weights {id = 1 : i32, storage = "external",
    type = tensor<?xf32>, uri = "file:arg0_text_encoder.data"}
  rhal.constant @text_positions {id = 2 : i32, storage = "external",
    type = tensor<?xi64>, uri = "file:arg1_text_encoder.data"}
  rhal.constant @unet_weights {id = 3 : i32, storage = "external",
    type = tensor<?xf32>, uri = "file:arg0_unet.data"}
  rhal.constant @vae_weights {id = 4 : i32, storage = "external",
    type = tensor<?xf32>, uri = "file:arg0_vae.data"}
  rhal.constant @vocab {id = 5 : i32, storage = "external",
    type = tensor<?xi8>, uri = "file:@MODEL_DIR@/stable-diffusion/vocab.txt"}
  rhal.codeobj @model_kernels {id = 1 : i32, kind = "host_shared_lib",
    backend = "cpu", uri = "file:libstable-diffusion-nv-origin-model.so"}
  rhal.codeobj @mlir_c_runner_utils {id = 2 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_c_runner_utils.so"}
  rhal.codeobj @mlir_runner_utils {id = 3 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_runner_utils.so"}
  rhal.codeobj @mlir_async_runtime {id = 4 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_async_runtime.so"}
  rhal.codeobj @mlir_cuda_runtime {id = 5 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_cuda_runtime.so"}
}
