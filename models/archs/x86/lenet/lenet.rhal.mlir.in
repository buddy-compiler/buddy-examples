rhal.module @lenet attributes {
  version = "0.1.0",
  model_name = "lenet_x86",
  runner_library = "file:liblenet-x86-runner.so"
} {
  // FP32 biases and scales, followed by offline INT8 weights.
  rhal.constant @params {
    id = 1 : i32, storage = "external",
    type = tensor<?xf32>, uri = "file:arg0.data"
  }

  rhal.constant @quantized_weights {
    id = 2 : i32, storage = "external",
    type = tensor<?xi8>, uri = "file:arg1.data"
  }

  // The host library contains the compiled x86 model.
  rhal.codeobj @model_kernels {
    id = 1 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:liblenet-x86-model.so", entry_symbol = "_mlir_ciface_forward"
  }
  rhal.codeobj @mlir_c_runner_utils {
    id = 2 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_c_runner_utils.so"
  }
  rhal.codeobj @mlir_runner_utils {
    id = 3 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_runner_utils.so"
  }

  rhal.buffer @image {space = "host", type = tensor<1x1x28x28xf32>}
  rhal.buffer @logits {space = "host", type = tensor<1x10xf32>}
  rhal.func @forward {
    inputs = ["image"], outputs = ["logits"],
    dispatch = "model_kernels", args = ["logits", "params", "quantized_weights", "image"]
  }
}
