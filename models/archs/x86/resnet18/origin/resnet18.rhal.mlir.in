rhal.module @resnet18 attributes {
  version = "0.1.0",
  model_name = "resnet18_x86_origin",
  runner_library = "file:libresnet18-x86-origin-runner.so"
} {
  rhal.constant @params {id = 1 : i32, storage = "external",
    type = tensor<?xf32>, uri = "file:arg0.data"}
  rhal.constant @labels {id = 2 : i32, storage = "external",
    type = tensor<?xi8>, uri = "file:@MODEL_DIR@/resnet18/Labels.txt"}
  rhal.codeobj @model_kernels {id = 1 : i32, kind = "host_shared_lib",
    backend = "cpu", uri = "file:libresnet18-x86-origin-model.so"}
  rhal.codeobj @mlir_c_runner_utils {id = 2 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_c_runner_utils.so"}
  rhal.codeobj @mlir_runner_utils {id = 3 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_runner_utils.so"}
}
