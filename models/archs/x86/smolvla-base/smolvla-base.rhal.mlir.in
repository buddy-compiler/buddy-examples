rhal.module @smolvla_base attributes {
  version = "0.1.0",
  model_name = "smolvla_base_x86_custom",
  runner_library = "file:libsmolvla-base-x86-custom-runner.so"
} {
  rhal.constant @weights {id = 1 : i32, storage = "external",
    type = tensor<?xf32>, uri = "file:arg0.data"}
  rhal.constant @int8_weights {id = 2 : i32, storage = "external",
    type = tensor<?xi8>, uri = "file:arg1.data"}
  rhal.codeobj @model_kernels {id = 1 : i32, kind = "host_shared_lib",
    backend = "cpu", uri = "file:libsmolvla-base-x86-custom-model.so"}
  rhal.codeobj @mlir_c_runner_utils {id = 2 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_c_runner_utils.so"}
  rhal.codeobj @mlir_runner_utils {id = 3 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/lib/libmlir_runner_utils.so"}
  rhal.codeobj @omp {id = 4 : i32, kind = "host_shared_lib", backend = "cpu",
    uri = "file:@BUDDY_SOURCE@/llvm/build/runtimes/runtimes-bins/openmp/runtime/src/libomp.so"}
}
